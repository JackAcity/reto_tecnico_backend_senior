<mxfile host="app.diagrams.net">
  <diagram name="arquitectura" id="arq-reto-carga-masiva">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1240" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ===== Cliente ===== -->
        <mxCell id="cliente" value="Cliente / Postman" style="rounded=0;whiteSpace=wrap;html=1;shadow=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="460" y="40" width="200" height="60" as="geometry" />
        </mxCell>

        <!-- ===== Gateway ===== -->
        <mxCell id="gateway" value="Gateway (YARP)&#10;JWT + rate limit + routing&#10;único puerto público: 8080" style="rounded=0;whiteSpace=wrap;html=1;shadow=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="460" y="160" width="200" height="70" as="geometry" />
        </mxCell>

        <!-- ===== Fila de microservicios ===== -->
        <mxCell id="auth" value="Auth&#10;/auth/login&#10;/auth/refresh" style="rounded=0;whiteSpace=wrap;html=1;shadow=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="310" width="200" height="70" as="geometry" />
        </mxCell>

        <mxCell id="control" value="Control&#10;POST /cargas&#10;GET /cargas*" style="rounded=0;whiteSpace=wrap;html=1;shadow=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="280" y="310" width="200" height="70" as="geometry" />
        </mxCell>

        <mxCell id="cargamasiva" value="CargaMasiva&#10;consumidor + publicador&#10;el núcleo" style="rounded=0;whiteSpace=wrap;html=1;shadow=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="520" y="310" width="200" height="70" as="geometry" />
        </mxCell>

        <mxCell id="notificaciones" value="Notificaciones&#10;consumidor" style="rounded=0;whiteSpace=wrap;html=1;shadow=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="760" y="310" width="200" height="70" as="geometry" />
        </mxCell>

        <!-- ===== Fila de infraestructura ===== -->
        <mxCell id="postgres" value="PostgreSQL&#10;una base, un esquema" style="rounded=0;whiteSpace=wrap;html=1;shadow=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="180" y="480" width="200" height="60" as="geometry" />
        </mxCell>

        <mxCell id="rabbitmq" value="RabbitMQ&#10;exchange topic 'cargas'" style="rounded=0;whiteSpace=wrap;html=1;shadow=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="420" y="480" width="200" height="60" as="geometry" />
        </mxCell>

        <mxCell id="seaweedfs" value="SeaweedFS&#10;filer HTTP" style="rounded=0;whiteSpace=wrap;html=1;shadow=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="660" y="480" width="200" height="60" as="geometry" />
        </mxCell>

        <mxCell id="mailpit" value="Mailpit&#10;SMTP de la demo" style="rounded=0;whiteSpace=wrap;html=1;shadow=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="900" y="480" width="180" height="60" as="geometry" />
        </mxCell>

        <!-- ===== Flechas: borde ===== -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="cliente" target="gateway">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e1l" value="HTTPS + Bearer JWT" style="text;html=1;align=center;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="670" y="115" width="160" height="20" as="geometry" />
        </mxCell>

        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="gateway" target="auth">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="gateway" target="control">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3b" value="/servicios/cargamasiva/* (diagnóstico)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;strokeColor=#999999;fontColor=#999999;fontSize=9;exitX=0.75;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="gateway" target="cargamasiva">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3c" value="/servicios/notificaciones/* (diagnóstico)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;strokeColor=#999999;fontColor=#999999;fontSize=9;exitX=1;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="gateway" target="notificaciones">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== Flechas: servicios -> infra síncronas ===== -->
        <mxCell id="e4" value="sube .xlsx" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="control" target="seaweedfs">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="INSERT Pendiente" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="control" target="postgres">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="valida usuario" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="auth" target="postgres">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== Flechas: mensajería asíncrona (punteadas) ===== -->
        <mxCell id="e7" value="publica MensajeCarga&#10;rk: carga.masiva" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;fontSize=10;" edge="1" parent="1" source="control" target="rabbitmq">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" value="consume&#10;cola: carga_masiva" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;fontSize=10;" edge="1" parent="1" source="rabbitmq" target="cargamasiva">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9" value="descarga .xlsx" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="cargamasiva" target="seaweedfs">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e10" value="sp_resolver_periodo&#10;sp_insertar_data_procesada" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="cargamasiva" target="postgres">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e11" value="publica MensajeNotificacion&#10;rk: carga.notificacion" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;fontSize=10;" edge="1" parent="1" source="cargamasiva" target="rabbitmq">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e12" value="consume&#10;cola: notificaciones" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;fontSize=10;" edge="1" parent="1" source="rabbitmq" target="notificaciones">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e13" value="SMTP" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="notificaciones" target="mailpit">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e14" value="UPDATE Notificado" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="notificaciones" target="postgres">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== Leyenda ===== -->
        <mxCell id="leyenda1" value="—— línea sólida: HTTP síncrono" style="text;html=1;align=left;fillColor=none;strokeColor=none;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="600" width="260" height="20" as="geometry" />
        </mxCell>
        <mxCell id="leyenda2" value="┄┄ línea punteada: mensaje asíncrono (RabbitMQ)" style="text;html=1;align=left;fillColor=none;strokeColor=none;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="622" width="320" height="20" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
