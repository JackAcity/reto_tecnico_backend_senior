# Copiar a .env antes de levantar:  cp .env.example .env
# El archivo .env está en .gitignore y nunca se versiona.

# --- PostgreSQL ---
POSTGRES_DB=reto
POSTGRES_USER=reto
POSTGRES_PASSWORD=cambiar_en_local

# --- RabbitMQ ---
RABBITMQ_USER=reto
RABBITMQ_PASSWORD=cambiar_en_local

# --- JWT ---
# Mínimo 32 caracteres (HS256). Generar uno propio para cualquier entorno real.
JWT_KEY=clave_de_desarrollo_cambiar_minimo_32_chars
JWT_ISSUER=reto-auth
JWT_AUDIENCE=reto-api
JWT_EXPIRA_MINUTOS=60
JWT_REFRESH_EXPIRA_DIAS=7

# --- Correo (§4.19: configurable por variables de entorno) ---
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_DESDE=no-reply@reto.local
SMTP_USAR_SSL=false

# --- Usuarios semilla (Auth los crea al arrancar si no existen) ---
SEED_EMAIL=admin@reto.local
SEED_PASSWORD=Reto2026!
SEED_ROL=administrador

# Rol sin permiso carga:masiva (PermisosDe) — prueba en vivo que la policy
# cargaMasiva rechaza a un usuario autenticado que no lo tiene.
SEED_CONSULTA_EMAIL=consulta@reto.local
SEED_CONSULTA_PASSWORD=Consulta2026!
SEED_CONSULTA_ROL=consulta

# --- Carga ---
# §2.4b: "validar que el archivo no exceda el tamaño máximo configurado"
CARGA_TAMANO_MAXIMO_MB=25

# --- CORS (Gateway) ---
# Origen del cliente React (Vite dev). Program.cs ya trae este mismo valor por
# default si la variable falta — está acá solo para que sea explícito y editable.
CORS_ORIGENES_PERMITIDOS=http://localhost:5173
